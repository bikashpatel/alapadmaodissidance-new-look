# Copy to .env and fill in. Never commit the real .env.

# Private address of the admin panel. Pick something hard to guess.
ADMIN_PATH=/studio-desk-change-me

# First-time admin password (at least 10 characters). Change it later in Admin -> Account.
ADMIN_PASSWORD=

# 1 when only Cloudflare (Tunnel or proxy) can reach the container; 0 if the port is public.
TRUST_PROXY=1

# Where the container is published on the host.
HOST_BIND=127.0.0.1
HOST_PORT=8080
